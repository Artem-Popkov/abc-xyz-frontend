# Адрес бэкенда. Пустое значение — запросы идут на тот же хост (относительный путь).
VITE_API_URL=http://localhost:8000

# true — расчёт идёт на моке (src/api/mockServer.js), бэкенд не нужен.
# Любое значение, кроме "false", включает мок.
VITE_USE_MOCKS=true

# true — мок имитирует ошибку сервера (для проверки состояния «ошибка» и кнопки «Повторить»).
VITE_MOCK_ERROR=false
